datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(uuid())
  email          String?        @unique
  passwordHash   String?        
  fullName       String
  role           String         @default("STUDENT") 
  
  parentId       String?        
  parent         User?          @relation("ParentChildren", fields: [parentId], references: [id])
  children       User[]         @relation("ParentChildren")
  
  subscriptions  Subscription[]
  userProgress   UserProgress[]
  activityLogs       ActivitySubmission[]
  
  globalLearnerState GlobalLearnerState?
  activityStates     ActivityState[]
  labRegistrations   LabRegistration[]
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentProviderId    String?            @unique 
  planId               String             
  status               String             @default("ACTIVE")
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model CourseSession {
  id              String         @id @default(uuid())
  sessionNumber   Int            @unique
  title           String
  description     String
  objective       String
  icon            String
  activityType    String         
  activityPayload String         
  unlockCode      String?
  progressRecords UserProgress[]
}

model UserProgress {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSessionId String?
  courseSession  CourseSession? @relation(fields: [courseSessionId], references: [id])
  sessionNumber  Int
  status         String        
  notes          String?
  reflection     String?
  completedAt    DateTime?
  updatedAt      DateTime      @updatedAt

  @@unique([userId, sessionNumber])
}

model ActivitySubmission {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionNumber Int
  activityType  String   
  payload       String   
  createdAt     DateTime @default(now())
}

model PortfolioActivity {
  id          String   @id @default(uuid())
  name        String
  href        String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalLearnerState {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String   // JSON string storing carry-forward variables
  updatedAt DateTime @updatedAt
}

model ActivityState {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String   // e.g. "activity_1", "activity_2"
  data       String   // JSON string storing autosave partial data
  updatedAt  DateTime @updatedAt

  @@unique([userId, activityId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model LabRegistration {
  id              String   @id @default(uuid())
  parentId        String
  parent          User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentFullName  String
  parentPhone     String
  parentEmail     String
  childFullName   String
  childAge        Int
  status          String   @default("PENDING") // PENDING, CONFIRMED
  generatedEmail  String?
  generatedPassword String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
